{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["${mod_author}"],
	"license": "${license}",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.romoslayer.daybreak.fabric.DaybreakFabric"]
	},
	"mixins": ["${mod_id}.mixins.json", "${mod_id}.fabric.mixins.json", "${mod_id}.ec2.mixins.json"],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${fabric_minecraft}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
